[
  {
    "name": "theme_info",
    "theme_name": "intranet",
    "theme_label": "t:theme_label",
    "theme_description": "t:theme_description",
    "theme_version": "2.0.0",
    "theme_scope": "community",
    "theme_author": "Baklib",
    "theme_documentation_url": "https://help.baklib.cn/themes/community/intranet",
    "theme_support_url": "https://help.baklib.cn/themes/community/intranet/settings",
    "theme_thumb_url": "images/theme/thumb.png",
    "theme_preview_images": [
      "images/theme/${lang}/cover.png",
      "images/theme/${lang}/index-mockup.png",
      "images/theme/${lang}/channel-mockup.png",
      "images/theme/${lang}/index.png",
      "images/theme/${lang}/channel.png",
      "images/theme/${lang}/events.png",
      "images/theme/${lang}/forum.png"
    ],
    "theme_languages": [
      {
        "name": "中文简体",
        "value": "zh-CN"
      },
      {
        "name": "English",
        "value": "en"
      },
      {
        "name": "Deutsch",
        "value": "de"
      },
      {
        "name": "Français",
        "value": "fr"
      },
      {
        "name": "日本語",
        "value": "ja"
      }
    ],
    "recommendations": {
      "color_schemas": {
        "fashion": {
          "name": "Fashion",
          "colors": {
            "--theme-color-primary": "#3D50E0",
            "--theme-color-secondary": "#E91E63",
            "--theme-color-accent": "#AAAAAA",
            "--theme-color-info": "#2196F3",
            "--theme-color-success": "#4CAF50",
            "--theme-color-warning": "#FFC107"
          }
        },
        "old_school": {
          "name": "Vintage",
          "colors": {
            "--theme-color-primary": "#9C27B0",
            "--theme-color-secondary": "#673AB7",
            "--theme-color-accent": "#AAAAAA",
            "--theme-color-info": "#418CC8",
            "--theme-color-success": "#29B52F",
            "--theme-color-warning": "#FFC107"
          }
        }
      },
      "initial_pages": {
        "default": {
          "name": "Intranet",
          "default": true,
          "pages": [
            {
              "name": "Channel",
              "slug": "channel",
              "template": "channel"
            },
            {
              "name": "Notifications",
              "slug": "notifications",
              "template": "changelog"
            },
            {
              "name": "Events",
              "slug": "events",
              "template": "events"
            },
            {
              "name": "FAQs",
              "slug": "faqs",
              "template": "faqs"
            },
            {
              "name": "Forum",
              "slug": "forum",
              "template": "forum"
            },
            {
              "name": "Products",
              "slug": "products",
              "template": "products"
            }
          ]
        }
      }
    }
  },
  {
    "name": "t:settings_schema.generic.name",
    "settings": [
      {
        "id": "is_allow_published",
        "type": "checkbox",
        "label": "t:settings_schema.intranet.is_allow_published_label",
        "info": "t:settings_schema.intranet.is_allow_published_info",
        "default": false
      },
      {
        "id": "logo_url",
        "type": "image_picker",
        "ratio": "3:1",
        "width": 150,
        "label": "t:settings_schema.intranet.logo_url_label"
      },
      {
        "id": "default_avatar",
        "type": "image_picker",
        "ratio": "4:4",
        "width": 100,
        "label": "t:settings_schema.intranet.default_avatar_label",
        "info": "t:settings_schema.intranet.default_avatar_info"
      },
      {
        "id": "hot_tags",
        "type": "text",
        "label": "t:settings_schema.intranet.hot_tags_label",
        "info": "t:settings_schema.intranet.hot_tags_info"
      },
      {
        "id": "is_allow_author",
        "type": "checkbox",
        "label": "t:settings_schema.intranet.is_allow_author_label",
        "default": true
      },
      {
        "id": "is_allow_feedback",
        "type": "checkbox",
        "label": "t:settings_schema.intranet.is_allow_feedback_label",
        "default": true
      },
      {
        "id": "feedback_useful_type",
        "type": "text",
        "label": "t:settings_schema.intranet.feedback_useful_type_label",
        "placeholder": "t:settings_schema.intranet.feedback_useful_type_placeholder",
        "default": "😊"
      },
      {
        "id": "slogan",
        "type": "text",
        "label": "t:settings_schema.intranet.slogan_label",
        "default": "Create community sites, code-free"
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:settings_schema.intranet.description_label",
        "default": "Browse beautifully designed templates, effortlessly customize it to meet your specific requirements."
      },
      {
        "id": "copyright_info",
        "type": "text",
        "label": "t:settings_schema.intranet.copyright_info_label",
        "placeholder": "t:settings_schema.intranet.copyright_info_placeholder"
      }
    ]
  },
  {
    "name": "t:settings_schema.nav.nav_title",
    "settings": [
      {
        "id": "header_menu_html",
        "type": "html",
        "label": "t:settings_schema.nav.settings.header_menu_html.label",
        "info": "t:settings_schema.nav.settings.header_menu_html.info",
        "rows": 10,
        "placeholder": "<a href='#'> title </a>"
      },
      {
        "id": "footer_menu_html",
        "type": "html",
        "label": "t:settings_schema.nav.settings.footer_menu_html.label",
        "info": "t:settings_schema.nav.settings.footer_menu_html.info",
        "rows": 10,
        "placeholder": "<a href='#'> title </a>"
      }
    ]
  },
  {
    "name": "t:settings_schema.nav.head_title",
    "settings": [
      {
        "id": "head_html",
        "type": "html",
        "label": "t:settings_schema.nav.settings.head_html.label",
        "info": "t:settings_schema.nav.settings.head_html.info",
        "rows": 10,
        "placeholder": "t:settings_schema.nav.settings.head_html.placeholder"
      }
    ]
  }
]
