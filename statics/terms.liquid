{% set_meta_title 'terms.title' | t %}

<main class="grow">
  <section>
    <div class="max-w-7xl px-4 mx-auto sm:px-6">
      <div class="pt-6 md:pt-12">
        <h1 class="h3 my-2">【{{ site.name }}】 {{ 'terms.title' | t }}</h1>
        <hr/>
        <ul class="list-inside space-y-2 mt-4 pl-8">
          <li>1. {{ 'terms.item_1' | t }}</li>
          <li>2. {{ 'terms.item_2' | t }}</li>
          <li>3. {{ 'terms.item_3' | t }}</li>
          <li>4. {{ 'terms.item_4' | t }}</li>
          <li>5. {{ 'terms.item_5' | t }}</li>
        </ul>
      </div>
    </div>
  </section>
</main>
