<div class="">
  <div class="p-4 truncate max-w-7xl">
    {% render 'breadcrumb', breadcrumb: page.breadcrumb %}
  </div>
</div>

<article class="w-full px-4 pt-6 pb-8 space-y-6 bg-white rounded-md shadow-sm shadow-gray-200 lg:pb-10 lg:pt-10 lg:px-6">
  <div class="max-w-screen-md mx-auto">
    <h1 class="text-2xl font-semibold text-center text-gray-800 lg:text-4xl">{{ page.settings.title }}</h1>
    {% if page.settings.description %}
      <blockquote class="mt-2 text-sm bg-slate-100 p-2 border-slate-300 border-l-2 text-gray-700">
        {{ page.settings.description }}
      </blockquote>
    {% endif %}
  </div>
  <!-- article -->
  <section class="max-w-screen-sm mx-auto">
    <div class="prose sm:prose-base lg:prose-base focus:outline-none dark:prose-invert">
      {% if page.settings.thumb_url %}
        <img src="{{ page.settings.thumb_url }}" class="object-contain w-full" alt="{{ page.link_text }}" />
      {% endif %}
      {{ page.settings.content }}
    </div>

    <!--Tags-->
    {% if page.settings.tags.size > 0 %}
      <div class="flex items-center py-4 mt-4 space-x-2 text-xs font-light md:mt-8 shrink-0 ">
          <p>{{ 'generic.tags' | t }}：</p>
          {% for tag in page.settings.tags %}
              <a href="{{ tag.path }}" style="background-color: {{ tag.color }}" class="px-2 py-1 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2">
              {{ tag.name }}
              </a>
          {% endfor %}
      </div>
    {% endif %}

    <!-- Feedback -->
    <div class="py-8 lg:flex lg:items-center lg:justify-between">
      <div></div>
      <div class="">
        <div class="text-lg font-bold text-slate-800">{{ 'generic.feedback' | t }}</div>
        {% render "feedback_form", page: page %}
      </div>
    </div>

    <!-- Sub Post Section -->
    {% render 'sub_page_list', page: page %}
  </section>
</article>

<!-- comments -->
<section class="max-w-screen-sm mx-auto w-full">
  {% if page.author.id == current_user.member_id %}
    <div class="my-4">
      <div class="relative p-5 border rounded-md bg-slate-200 dark:bg-slate-800 border-slate-600">
        <div class="items-center space-y-3 sm:flex sm:space-y-0 sm:space-x-5">
            <a href="/s/edit?page_path={{ page.full_slug }}" class="btn">
              <span>{{ 'buttons.edit_again' | t }}</span>
            </a>
            {% form_tag 'delete_page', page %}
              <button class="btn btn-ghost"> {{ 'buttons.delete' | t }} </button>
            {% endform_tag %}
        </div>
      </div>
    </div>
  {% endif %}

  {% unless page.published_at %}
    <p class="mt-4 text-sm font-bold text-info"> {{ 'generic.under_review_post' | t }} </p>
  {% endunless %}
  
  <div class="my-4">
    {% render 'reply_page_form', target: page %}
  </div>

  <!-- Comments list -->
  <div data-controller="load_more">
    <h4 class="mb-2 font-bold "> {{ 'generic.comments_count' | t: count: page.comments.size }} </h4>
    <!-- Comments (1st level) -->
    {% assign answers = page.comments | roots  %}
    <ul id="page_{{ page.id }}_replies_list" data-load_more-target="container">
      {% paginate_tag answers, per: 4 %}
        {% for reply in answers %}
          {% render 'reply', reply: reply %}
        {% endfor %}
      {% endpaginate_tag %}
    </ul>
    {{ paginate.next.page  }}
    {% if paginate.next_page %}
      <button id="load_more" data-action="click->load_more#loadMore" data-load_more-url-value="/s/replies?page_path={{ page.full_slug }}&_page={{ paginate.next_page }}"
      data-load_more-target="button"
      >
        {{ 'generic.load_more_replies' | t }}
      </button>
    {% endif %}
  </div>
</section>


<!--/ article-->
{% schema %}
    {
    "name": "t:settings_schema.intranet_templates.event_name",
    "thumb_url": "images/theme/${lang}/event.png",
    "description": "t:settings_schema.intranet_templates.event_description",
    "sub_page_templates": [],
    "settings": [
        {
          "id": "type",
          "type": "select",
          "default": "0",
          "choices": [
            {"label":"t:settings_schema.intranet_templates.shared_type_choice_blog","value":"0"},
            {"label":"t:settings_schema.intranet_templates.shared_type_choice_project","value":"1"},
            {"label":"t:settings_schema.intranet_templates.shared_type_choice_other","value":"2"}
          ],
          "label": "t:settings_schema.intranet_templates.shared_type_label"
        },
        {
          "id": "tags",
          "type": "tag_picker",
          "multiple": true,
          "label": "t:settings_schema.intranet_templates.shared_tags_label"
        },
        {
          "id": "date",
          "type": "date",
          "label": "t:settings_schema.intranet_templates.shared_event_date_label"
        },
        {
          "id": "thumb_url",
          "type": "image_picker",
          "ratio": "6:4",
          "width": 400,
          "label": "t:settings_schema.intranet_templates.shared_thumb_image_label"
        },
        {
          "id": "title",
          "type": "text",
          "placeholder": "",
          "label": "t:settings_schema.intranet_templates.shared_title_label",
          "info": "t:settings_schema.intranet_templates.shared_title_info"
        },
        {
          "id": "description",
          "type": "text",
          "placeholder": "",
          "label": "t:settings_schema.intranet_templates.shared_description_text_label",
          "info": "t:settings_schema.intranet_templates.shared_description_text_info"
        },
        {
          "id": "content",
          "type": "richtext",
          "label": "t:settings_schema.intranet_templates.shared_content_label"
        }
    ],
    "user_creatable": true,
    "user_editable": true,
    "user_deletable": true,
    "user_permitted_attributes": ["title", "content"]
    }
{% endschema %}
